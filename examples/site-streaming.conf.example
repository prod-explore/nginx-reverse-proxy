# STEP 2, variant for server-sent events, long polling and WebSockets: no buffering,
# long timeouts. Same as site.conf.example except the two lines marked (*).
#
# The site. Replace every "stream.example.com" with your domain and
# "stream-app:8080" with <container name>:<port> of the backend (reachable from one of the
# networks listed in docker-compose.override.yml).

server {
    listen 80;
    server_name stream.example.com;

    include snippets/acme-challenge.conf;

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name stream.example.com;

    ssl_certificate     /etc/letsencrypt/live/stream.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/stream.example.com/privkey.pem;

    include snippets/security-headers.conf;

    client_max_body_size 10m;          # raise where uploads are expected

    # Never serve dotfiles (.git, .env, ...).
    location ~ /\.(?!well-known) {
        deny all;
    }

    location / {
        # A variable makes nginx resolve the name per request: the backend can restart,
        # or not exist yet, without breaking nginx.
        set $upstream http://stream-app:8080;
        proxy_pass $upstream;

        include snippets/proxy-headers.conf;
        include snippets/proxy-streaming.conf;        # (*)

        limit_req  zone=perip burst=60 nodelay;
        limit_conn connperip 200;                      # (*) streams are long-lived
    }
}
