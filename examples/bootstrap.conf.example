# STEP 1 of adding a site: serves only the ACME challenge, so that a certificate
# can be issued. Replace app.example.com, issue the certificate (see the README),
# then replace this file with site.conf.example.
server {
    listen 80;
    server_name app.example.com;

    include snippets/acme-challenge.conf;

    location / {
        return 404;
    }
}
