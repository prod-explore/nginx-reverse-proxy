# Step 2, variant: a frontend and an API in different containers, with a stricter
# limit on the login endpoint. Same as site.conf.example, with more locations.
#
#   cp examples/site-frontend-and-api.conf.example sites/<domain>.conf
#
# Replace every "shop.example.com" with the domain, "shop-web:80" and
# "shop-api:3000" with <container name>:<port> of the two backends (reachable
# from one of the networks listed in docker-compose.override.yml), then run
# scripts/reload.sh. /api/... reaches the API unchanged, so it must serve its
# routes under /api.

server {
    listen 80;
    listen [::]:80;
    server_name shop.example.com;

    include snippets/acme-challenge.conf;

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name shop.example.com;

    ssl_certificate     /etc/letsencrypt/live/shop.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/shop.example.com/privkey.pem;

    include snippets/security-headers.conf;

    client_max_body_size 10m;          # raise where uploads are expected

    # Never serve dotfiles (.git, .env, ...).
    location ~ /\.(?!well-known) {
        deny all;
    }

    location /api/ {
        set $api http://shop-api:3000;
        proxy_pass $api;

        include snippets/proxy-headers.conf;
        include snippets/proxy-timeouts.conf;

        limit_req  zone=perip burst=60 nodelay;
        limit_conn connperip 50;
    }

    # Brute-force protection: 5 requests per minute per address (zone "login"),
    # a burst of 5 answered at once, then 429. An exact match wins over /api/.
    # No limit_conn here: at 5 requests a minute, a cap on parallel connections
    # adds nothing.
    location = /api/login {
        set $api http://shop-api:3000;
        proxy_pass $api;

        include snippets/proxy-headers.conf;
        include snippets/proxy-timeouts.conf;

        limit_req zone=login burst=5 nodelay;
    }

    location / {
        set $web http://shop-web:80;
        proxy_pass $web;

        include snippets/proxy-headers.conf;
        include snippets/proxy-timeouts.conf;

        limit_req  zone=perip burst=60 nodelay;
        limit_conn connperip 50;
    }
}
