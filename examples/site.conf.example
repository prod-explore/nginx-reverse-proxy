# Step 2: a site with one backend, once its certificate exists (until then, use
# site-before-certificate.conf.example).
#
#   cp examples/site.conf.example sites/<domain>.conf
#
# Replace every "app.example.com" with the domain and "app:3000" with
# <container name>:<port> of the backend (reachable from one of the networks
# listed in docker-compose.override.yml), then run scripts/reload.sh.

server {
    listen 80;
    listen [::]:80;
    server_name app.example.com;

    include snippets/acme-challenge.conf;

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name app.example.com;

    ssl_certificate     /etc/letsencrypt/live/app.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/app.example.com/privkey.pem;

    include snippets/security-headers.conf;

    client_max_body_size 10m;          # raise where uploads are expected

    # Never serve dotfiles (.git, .env, ...).
    location ~ /\.(?!well-known) {
        deny all;
    }

    location / {
        # A variable makes nginx resolve the name per request: the backend can restart,
        # or not exist yet, without breaking nginx.
        set $upstream http://app:3000;
        proxy_pass $upstream;

        include snippets/proxy-headers.conf;
        include snippets/proxy-timeouts.conf;

        limit_req  zone=perip burst=60 nodelay;
        limit_conn connperip 50;
    }
}
