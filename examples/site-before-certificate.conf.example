# Step 1 of every site, before its certificate exists. nginx refuses to load a
# site whose certificate file is missing, so this file serves only the ACME
# challenge on port 80, which lets certbot issue the certificate.
#
#   cp examples/site-before-certificate.conf.example sites/<domain>.conf
#
# Replace "app.example.com" with the domain, run scripts/reload.sh and issue the
# certificate (see the README). Then copy one of the step 2 examples
# (site.conf.example or a variant) over it.

server {
    listen 80;
    listen [::]:80;
    server_name app.example.com;

    include snippets/acme-challenge.conf;

    location / {
        return 404;
    }
}
